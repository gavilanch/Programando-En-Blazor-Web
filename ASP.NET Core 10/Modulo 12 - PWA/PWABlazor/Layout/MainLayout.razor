@inherits LayoutComponentBase
<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
        </div>

        <article class="content px-4">
            @if (!EsDebug())
            {
                <ActualizacionDisponible />
            }
            @Body
        </article>
    </main>
</div>

@code {
    public bool EsDebug()
    {
#if DEBUG
      return true;
#else
        return false;
#endif
    }

}